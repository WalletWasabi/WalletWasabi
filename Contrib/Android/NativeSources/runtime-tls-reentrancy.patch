@@ -791,21 +794,34 @@ cleanup:
 PAL_SSLStreamStatus AndroidCryptoNative_SSLStreamHandshake(SSLStream* sslStream)
 {
     abort_if_invalid_pointer_argument (sslStream);
+    // Certificate validation runs synchronously inside SSLEngine.unwrap. On
+    // rejection, managed SslStream asks for an alert by re-entering this same
+    // handshake. Legacy Conscrypt holds a non-recursive native mutex there.
+    // Fail this nested call; the original trust callback still rejects the
+    // certificate and lets the original handshake unwind with authentication
+    // failure. Unrelated SSLStream instances and normal handshakes are unchanged.
+    if (atomic_exchange_explicit(&sslStream->handshakeInProgress, true, memory_order_acquire))
+        return SSLStreamStatus_Error;
+
+    PAL_SSLStreamStatus ret = SSLStreamStatus_Error;
     JNIEnv* env = GetJNIEnv();
 
     int handshakeStatus = GetHandshakeStatus(env, sslStream);
     if (handshakeStatus == -1)
-        return SSLStreamStatus_Error;
+        goto cleanup;
 
     if (!IsHandshaking(handshakeStatus))
     {
         // sslEngine.beginHandshake();
         (*env)->CallVoidMethod(env, sslStream->sslEngine, g_SSLEngineBeginHandshake);
         if (CheckJNIExceptions(env))
-            return SSLStreamStatus_Error;
+            goto cleanup;
     }
 
-    return DoHandshake(env, sslStream);
+    ret = DoHandshake(env, sslStream);
+cleanup:
+    atomic_store_explicit(&sslStream->handshakeInProgress, false, memory_order_release);
+    return ret;
 }
 
 PAL_SSLStreamStatus

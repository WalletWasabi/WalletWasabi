<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>io.wasabiwallet.android.runtimeprobe</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="'$(WasabiEmulatorOnly)' == 'true'">android-x64</RuntimeIdentifiers>
    <UseMonoRuntime>true</UseMonoRuntime>
    <UseInterpreter>false</UseInterpreter>
    <UseNativeHttpHandler>false</UseNativeHttpHandler>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <RunAOTCompilation>false</RunAOTCompilation>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidUseAssemblyStore>false</AndroidUseAssemblyStore>
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <DefineConstants>$(DefineConstants);WASABI_RUNTIME_PROBE</DefineConstants>
  </PropertyGroup>
  <Import Project="../MonoRuntime.props" />
  <ItemGroup Condition="'$(WasabiProbeRuntimeVersion)' != ''">
    <FrameworkReference Update="Microsoft.NETCore.App" RuntimeFrameworkVersion="$(WasabiProbeRuntimeVersion)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NBitcoin" />
    <PackageReference Include="WabiSabi" ExcludeAssets="native" />
    <Compile Include="../../../WalletWasabi.Android/RuntimeProbe.cs" Link="RuntimeProbe.cs" />
    <ProjectReference Include="../../../WalletWasabi/WalletWasabi.csproj" />
  </ItemGroup>
  <Import Project="../NativePageAlignment.targets" />
  <Import Project="../NativeSources.targets" />
  <Target Name="UseIsolatedTlsDiagnostic" BeforeTargets="_BuildApkEmbed"
      Condition="'$(WasabiTlsDiagnosticLibrary)' != ''">
    <Error Condition="'$(Configuration)' != 'Debug' Or '$(WasabiEmulatorOnly)' != 'true' Or !Exists('$(WasabiTlsDiagnosticLibrary)')" Text="TLS diagnostics require the isolated Debug emulator probe and an existing diagnostic library." />
    <ItemGroup>
      <FrameworkNativeLibrary Remove="@(FrameworkNativeLibrary)" Condition="'%(FrameworkNativeLibrary.Filename)' == 'libSystem.Security.Cryptography.Native.Android'" />
      <FrameworkNativeLibrary Include="$(WasabiTlsDiagnosticLibrary)" Abi="x86_64" />
    </ItemGroup>
  </Target>
</Project>

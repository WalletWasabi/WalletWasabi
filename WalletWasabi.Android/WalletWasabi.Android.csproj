<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-android36.0</TargetFramework>
		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
		<OutputType>Exe</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<WasabiPackageChannel Condition="'$(WasabiPackageChannel)' == ''">Development</WasabiPackageChannel>
		<ApplicationId>io.wasabiwallet.android.dev</ApplicationId>
		<ApplicationId Condition="'$(WasabiPackageChannel)' == 'Personal'">io.wasabiwallet.android.personal</ApplicationId>
		<ApplicationTitle>Wasabi Wallet Test</ApplicationTitle>
		<ApplicationTitle Condition="'$(WasabiPackageChannel)' == 'Personal'">Wasabi Wallet</ApplicationTitle>
		<ApplicationVersion>16</ApplicationVersion>
		<ApplicationDisplayVersion>0.3.11</ApplicationDisplayVersion>
		<RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
		<RuntimeIdentifiers Condition="'$(WasabiEmulatorOnly)' == 'true'">android-x64</RuntimeIdentifiers>
		<NuGetLockFilePath Condition="'$(WasabiEmulatorOnly)' == 'true'">packages.emulator.lock.json</NuGetLockFilePath>
		<AndroidPackageFormats>apk</AndroidPackageFormats>
		<!-- Mono 10.0.9 deadlocks during class initialization with this engine in
		     the assembly store. Individual assembly packaging preserves engine IL. -->
		<AndroidUseAssemblyStore>false</AndroidUseAssemblyStore>
		<!-- Dynamic JNI registration keeps the framework assembly identical in
		     the app and separate release harness. Native marshal-method rewriting
		     otherwise produces incompatible compressed Mono.Android sizes. -->
		<AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
		<PublishTrimmed>false</PublishTrimmed>
		<RunAOTCompilation>false</RunAOTCompilation>
		<!-- The Android assembly pipeline cannot rewrite ReadyToRun assemblies. -->
		<PublishReadyToRun>false</PublishReadyToRun>
		<UseMonoRuntime>true</UseMonoRuntime>
		<!-- The Mono interpreter rejects valid managed WabiSabi proofs on x64.
		     Both configurations use the supported Mono JIT; qualify AOT separately. -->
		<UseInterpreter>false</UseInterpreter>
		<!-- The Java HTTP handler treats SOCKS proxies as HTTP CONNECT proxies. -->
		<UseNativeHttpHandler>false</UseNativeHttpHandler>
		<DefineConstants Condition="'$(WasabiPackageChannel)' == 'Personal'">$(DefineConstants);WASABI_PERSONAL</DefineConstants>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
	</PropertyGroup>
	<Import Project="../Contrib/Android/MonoRuntime.props" />
	<ItemGroup>
		<ProjectReference Include="..\WalletWasabi.Mobile\WalletWasabi.Mobile.csproj" AdditionalProperties="WasabiAndroidPackage=$(WasabiPackageChannel)" />
		<PackageReference Include="ZXing.Net" />
		<!-- Android uses the managed credential implementation, not desktop ELF libraries. -->
		<PackageReference Include="WabiSabi" ExcludeAssets="native" />
		<AndroidNativeLibrary Update="Native\arm64-v8a\libtor.so" />
		<AndroidNativeLibrary Update="Native\x86_64\libtor.so" />
		<AndroidAsset Include="..\WalletWasabi\Tor\Geoip\geoip" Link="Tor\geoip" />
		<AndroidAsset Include="..\WalletWasabi\Tor\Geoip\geoip6" Link="Tor\geoip6" />
		<AndroidAsset Include="..\LICENSE.md" Link="Legal\Wasabi.txt" />
		<AndroidResource Include="..\Contrib\Assets\WasabiLogo256.png" Link="Resources\drawable\wasabi_logo.png" />
		<AndroidAsset Include="$(WasabiCoordinatorBootstrapFile)" Link="PersonalCoordinator.json" Condition="'$(WasabiPackageChannel)' == 'Personal' And '$(WasabiCoordinatorBootstrapFile)' != ''" />
		<AndroidAsset Include="..\WalletWasabi\BundledApps\Binaries\win-x64\Tor\LICENSE" Link="Legal\Tor.txt" />
	</ItemGroup>
	<Import Project="../Contrib/Android/NativePageAlignment.targets" />
	<Import Project="../Contrib/Android/NativeSources.targets" />
	<Target Name="RequireTor" BeforeTargets="PrepareForBuild">
		<Error Condition="'$(WasabiPackageChannel)' != 'Development' And '$(WasabiPackageChannel)' != 'Personal'" Text="Choose the Development or Personal package channel." />
		<Error Condition="!Exists('Native/arm64-v8a/libtor.so') Or !Exists('Native/x86_64/libtor.so')" Text="Run Contrib/Android/prepare-tor.ps1 before building Android." />
		<Error Condition="'$(Configuration)' == 'Release' And '$(WasabiMonoRuntimeVersion)' != '10.0.12'" Text="Release requires the pinned Mono servicing runtime. Requalify a runtime change before delivery." />
		<Error Condition="'$(Configuration)' == 'Release' And ('$(UseMonoRuntime)' != 'true' Or '$(UseInterpreter)' != 'false' Or '$(AndroidUseAssemblyStore)' != 'false' Or '$(PublishTrimmed)' != 'false' Or '$(RunAOTCompilation)' != 'false' Or '$(PublishReadyToRun)' != 'false' Or '$(AndroidEnableMarshalMethods)' != 'false')" Text="Release requires the qualified untrimmed Mono JIT, dynamic JNI and individual assembly packaging. AOT needs separate qualification." />
		<Error Condition="'$(WasabiPackageChannel)' == 'Personal' And ('$(Configuration)' != 'Release' Or '$(AndroidKeyStore)' != 'true' Or !Exists('$(AndroidSigningKeyStore)'))" Text="Personal packages require Release configuration and the dedicated external signing key." />
		<Error Condition="'$(WasabiPackageChannel)' == 'Personal' And !Exists('$(WasabiCoordinatorBootstrapFile)')" Text="Personal packages require the approved two-field coordinator bootstrap." />
		<Error Condition="'$(WasabiPackageChannel)' == 'Personal' And !Exists('$(WasabiNativeBuildDirectory)/native-manifest.json')" Text="Personal packages require the verified pinned native source build." />
	</Target>
</Project>

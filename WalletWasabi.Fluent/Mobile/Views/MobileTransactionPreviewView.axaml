<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="using:WalletWasabi.Fluent.Mobile.Controls" xmlns:c="using:WalletWasabi.Fluent.Controls" xmlns:vm="using:WalletWasabi.Fluent.ViewModels.Wallets.Send" xmlns:send="using:WalletWasabi.Fluent.Views.Wallets.Send" x:Class="WalletWasabi.Fluent.Mobile.Views.MobileTransactionPreviewView" x:DataType="vm:TransactionPreviewViewModel" x:CompileBindings="True">
  <UserControl.Resources><m:MobilePrivacyMessageConverter x:Key="PrivacyMessage"/></UserControl.Resources>
  <m:MobilePage Header="Review transaction" ShowBack="True" BackCommand="{Binding BackCommand}" IsBusy="{Binding IsBusy}">
    <m:MobilePage.HeaderActions><Button Classes="mobile-button flat" Command="{Binding CancelCommand}" AutomationProperties.Name="Cancel payment"><m:MobileGlyph Kind="close" Width="20" Height="20" Foreground="{DynamicResource MobileText}"/></Button></m:MobilePage.HeaderActions>
    <m:MobilePage.Footer><StackPanel Spacing="8"><Button Classes="mobile-button primary" Content="{Binding NextButtonText}" Command="{Binding NextCommand}" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="MobileConfirmTransaction"/><Button Classes="mobile-button" Content="Sign and send instead" Command="{Binding SkipCommand}" IsVisible="{Binding PreferPsbtWorkflow}" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch"/></StackPanel></m:MobilePage.Footer>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="16,8,16,16" Spacing="16">
      <Border Classes="mobile-card"><StackPanel Spacing="12"><m:MobileGlyph Kind="send" Width="42" Height="42" Foreground="{DynamicResource MobileAccent}" HorizontalAlignment="Center"/><TextBlock Text="You are sending" Classes="mobile-caption" HorizontalAlignment="Center"/><c:AmountControl Amount="{Binding DisplayedTransactionSummary.Amount}" Classes="WithUsd" HorizontalAlignment="Center"/><TextBlock Text="{Binding DisplayedTransactionSummary.AddressText}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource MobileText}" IsVisible="{Binding !CurrentTransactionSummary.IsPayToMany}"/><TextBlock Text="{Binding DisplayedTransactionSummary.Recipient}" Classes="mobile-caption" TextWrapping="Wrap"/></StackPanel></Border>
      <ItemsControl ItemsSource="{Binding DisplayedTransactionSummary.Recipients}" IsVisible="{Binding CurrentTransactionSummary.IsPayToMany}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:RecipientSummaryViewModel"><Border Classes="mobile-card" Margin="0,0,0,8"><StackPanel Spacing="8"><TextBlock Text="{Binding AddressText}" Foreground="{DynamicResource MobileText}" TextWrapping="Wrap"/><c:AmountControl Amount="{Binding Amount}" Classes="WithUsd"/><TextBlock Text="{Binding Recipient}" Classes="mobile-caption"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Border Classes="mobile-card"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Network fee" Classes="mobile-caption"/><c:AmountControl Grid.Column="1" Amount="{Binding DisplayedTransactionSummary.Fee}"/></Grid><TextBlock Text="{Binding DisplayedTransactionSummary.FeeRate.SatoshiPerByte, StringFormat='Fee rate: {0:0.###} sat/vB'}" Classes="mobile-caption"/><TextBlock Text="{Binding DisplayedTransactionSummary.ConfirmationTime, StringFormat='Estimated confirmation: {0}'}" Classes="mobile-caption"/><TextBlock Text="Confirmation estimates are not guarantees." Classes="mobile-caption"/></StackPanel></Border>
      <Grid ColumnDefinitions="*,*"><Button Classes="mobile-button" Content="Network fee" Command="{Binding AdjustFeeCommand}" IsEnabled="{Binding IsFeeAdjustable}" ToolTip.Tip="{Binding FeeAdjustToolTip}" HorizontalAlignment="Stretch" Margin="0,0,8,0"/><Button Grid.Column="1" Classes="mobile-button" Content="Select coins" Command="{Binding ChangeCoinsCommand}" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch"/></Grid>
      <Button Classes="mobile-button flat" Content="Undo last change" Command="{Binding UndoCommand}" IsVisible="{Binding CanUndo}"/>
      <TextBlock Text="Privacy review" Classes="mobile-label"/>
      <ItemsControl ItemsSource="{Binding PrivacySuggestions.Warnings}"><ItemsControl.ItemTemplate><DataTemplate x:CompileBindings="False"><Border Classes="mobile-note" Margin="0,0,0,8"><Grid ColumnDefinitions="28,*"><m:MobileGlyph Kind="shield" Width="20" Height="20" Foreground="{DynamicResource MobileWarning}"/><TextBlock Grid.Column="1" Text="{Binding Converter={StaticResource PrivacyMessage}}" Foreground="{DynamicResource MobileText}" TextWrapping="Wrap"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Border Classes="mobile-note" IsVisible="{Binding PrivacySuggestions.MaxPrivacy}"><TextBlock Text="No privacy warnings were found for the current transaction. This is not a guarantee of anonymity." Classes="mobile-caption"/></Border>
      <ListBox Classes="mobile-stretch-list" ItemsSource="{Binding PrivacySuggestions.Suggestions}" SelectedItem="{Binding PrivacySuggestions.SelectedSuggestion, Mode=TwoWay}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate x:CompileBindings="False"><Border Classes="mobile-card" Margin="0,4"><TextBlock Text="{Binding Converter={StaticResource PrivacyMessage}}" Foreground="{DynamicResource MobileText}" TextWrapping="Wrap"/></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
      <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding PrivacySuggestions.IsBusy}"/>
      <Border Classes="mobile-note" IsVisible="{Binding CurrentTransactionSummary.IsPayJoin}"><TextBlock Text="PayJoin is enabled for this payment." Classes="mobile-caption"/></Border>
      <Expander Header="Advanced transaction details" HorizontalAlignment="Stretch"><ScrollViewer HorizontalScrollBarVisibility="Auto"><send:TransactionSummary DataContext="{Binding DisplayedTransactionSummary}"/></ScrollViewer></Expander>
      <TextBlock Text="Check the recipient and every amount. Confirmation continues through Wasabi's existing wallet authorization flow." Classes="mobile-caption"/>
    </StackPanel></ScrollViewer>
  </m:MobilePage>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="using:WalletWasabi.Fluent.Mobile.Controls" xmlns:vm="using:WalletWasabi.Fluent.ViewModels.AddWallet" x:Class="WalletWasabi.Fluent.Mobile.Views.MobileWalletNameView" x:DataType="vm:WalletNamePageViewModel" x:CompileBindings="True">
  <m:MobilePage Header="Name your wallet" ShowBack="{Binding EnableBack}" BackCommand="{Binding BackCommand}" IsBusy="{Binding IsBusy}">
    <m:MobilePage.Footer><Button Classes="mobile-button primary" Content="Continue" Command="{Binding NextCommand}" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch"/></m:MobilePage.Footer>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="16,24" Spacing="20"><m:MobileGlyph Kind="leaf" Width="72" Height="72" Foreground="{DynamicResource MobileAccent}" HorizontalAlignment="Center"/><TextBlock Text="A name that feels like yours." Classes="mobile-title" TextWrapping="Wrap"/><TextBlock Text="Wallet name" Classes="mobile-label"/><TextBox Classes="mobile-input" Text="{Binding WalletName, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}" MaxLength="100" Watermark="My Bitcoin wallet" AutomationProperties.Name="Wallet name"/><Border Classes="mobile-note"><TextBlock Text="This name identifies the wallet on this device. It is not included in Bitcoin transactions." Classes="mobile-caption"/></Border></StackPanel></ScrollViewer>
  </m:MobilePage>
</UserControl>

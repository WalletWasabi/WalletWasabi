<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:WalletWasabi.Fluent.Mobile.Controls" xmlns:c="using:WalletWasabi.Fluent.Controls"
             xmlns:models="using:WalletWasabi.Fluent.Models" xmlns:words="using:WalletWasabi.Fluent.ViewModels.AddWallet.Create"
             xmlns:ime="clr-namespace:Avalonia.Input.TextInput;assembly=Avalonia.Base"
             xmlns:vm="using:WalletWasabi.Fluent.ViewModels.AddWallet.Create"
             x:Class="WalletWasabi.Fluent.Mobile.Views.MobileRecoveryWordsView" x:DataType="vm:RecoveryWordsViewModel" x:CompileBindings="True">
  
  <m:MobilePage Header="Your recovery words" ShowBack="True" BackCommand="{Binding BackCommand}">
    <m:MobilePage.Footer><Button Name="PrimaryAction" Classes="mobile-button primary" Content="Verify my backup" Command="{Binding NextCommand}" HorizontalAlignment="Stretch" IsEnabled="{Binding #BackupWords.IsAcknowledged}"/></m:MobilePage.Footer>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="{DynamicResource MobileGutter}" Spacing="{DynamicResource MobileSpaceLarge}">
        <TextBlock Text="Your backup stays with you" Classes="mobile-title" TextWrapping="Wrap"/>
        <TextBlock Text="Write each word down in its numbered order. You will verify the words on the next screen." Classes="mobile-caption"/>
        <m:MobileSecretPanel Name="BackupWords" Header="Recovery words">
          <ItemsControl ItemsSource="{Binding MnemonicWords}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="words:RecoveryWordViewModel">
              <m:MobileRecoveryWordTile Index="{Binding Index}" Word="{Binding Word}" IsConfirmed="{Binding IsConfirmed}" Margin="{DynamicResource MobileBackupWordMargin}"/>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </m:MobileSecretPanel>
        <Border Classes="mobile-note"><TextBlock Text="Do not save a screenshot or send these words to anyone. If you add a passphrase later, store it safely too: it is required to restore that wallet." Classes="mobile-caption"/></Border>
      </StackPanel>
    </ScrollViewer>
  </m:MobilePage>
</UserControl>

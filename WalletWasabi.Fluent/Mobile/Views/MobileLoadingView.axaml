<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="using:WalletWasabi.Fluent.Mobile.Controls" xmlns:vm="using:WalletWasabi.Fluent.ViewModels.Wallets" x:Class="WalletWasabi.Fluent.Mobile.Views.MobileLoadingView" x:DataType="vm:LoadingViewModel" x:CompileBindings="True">
  <m:MobilePage Header="Synchronizing">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="16,16" Spacing="16">
      <m:MobileGlyph Kind="coinjoin" Width="56" Height="56" Foreground="{DynamicResource MobileAccent}" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding WalletName}" Classes="mobile-title" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock Text="Checking your wallet against the Bitcoin network." Classes="mobile-caption" TextAlignment="Center"/>
      <Border Classes="mobile-card"><StackPanel Spacing="10"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Peers connected" Classes="mobile-label"/><TextBlock Grid.Column="1" Text="{Binding Peers.Current, StringFormat='{}{0:N0}'}" Foreground="{DynamicResource MobileAccent}"/></Grid><ProgressBar Minimum="0" Maximum="100" Value="{Binding Peers.Percent}" Height="4" Foreground="{DynamicResource MobileAccent}" Background="{DynamicResource MobileRingTrack}"/></StackPanel></Border>
      <Border Classes="mobile-card"><StackPanel Spacing="10"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Block headers" Classes="mobile-label"/><TextBlock Grid.Column="1" Text="{Binding BlockHeaders.Current, StringFormat='{}{0:N0}'}" Foreground="{DynamicResource MobileAccent}"/></Grid><ProgressBar Minimum="0" Maximum="100" Value="{Binding BlockHeaders.Percent}" Height="4" Foreground="{DynamicResource MobileAccent}" Background="{DynamicResource MobileRingTrack}"/></StackPanel></Border>
      <Border Classes="mobile-card"><StackPanel Spacing="10"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Filter headers" Classes="mobile-label"/><TextBlock Grid.Column="1" Text="{Binding FilterHeaders.Current, StringFormat='{}{0:N0}'}" Foreground="{DynamicResource MobileAccent}"/></Grid><ProgressBar Minimum="0" Maximum="100" Value="{Binding FilterHeaders.Percent}" Height="4" Foreground="{DynamicResource MobileAccent}" Background="{DynamicResource MobileRingTrack}"/></StackPanel></Border>
      <Border Classes="mobile-card"><StackPanel Spacing="10"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Compact filters" Classes="mobile-label"/><TextBlock Grid.Column="1" Text="{Binding CompactFilters.Current, StringFormat='{}{0:N0}'}" Foreground="{DynamicResource MobileAccent}"/></Grid><ProgressBar Minimum="0" Maximum="100" Value="{Binding CompactFilters.Percent}" Height="4" Foreground="{DynamicResource MobileAccent}" Background="{DynamicResource MobileRingTrack}"/></StackPanel></Border>
      <Border Classes="mobile-card"><StackPanel Spacing="10"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Wallet blocks" Classes="mobile-label"/><TextBlock Grid.Column="1" Text="{Binding Blocks.Current, StringFormat='{}{0:N0}'}" Foreground="{DynamicResource MobileAccent}"/></Grid><ProgressBar Minimum="0" Maximum="100" Value="{Binding Blocks.Percent}" Height="4" Foreground="{DynamicResource MobileAccent}" Background="{DynamicResource MobileRingTrack}"/></StackPanel></Border>
      <TextBlock Text="{Binding LatestBlock, StringFormat='Latest block: {0:N0}'}" Classes="mobile-caption"/>
      <Border Classes="mobile-note"><TextBlock Text="Progress comes from the wallet's synchronizer. Keep the app open while initial synchronization completes." Classes="mobile-caption"/></Border>
    </StackPanel></ScrollViewer>
  </m:MobilePage>
</UserControl>

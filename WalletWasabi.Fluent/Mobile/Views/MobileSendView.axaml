<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="using:WalletWasabi.Fluent.Mobile.Controls" xmlns:c="using:WalletWasabi.Fluent.Controls" xmlns:vm="using:WalletWasabi.Fluent.ViewModels.Wallets.Send" x:Class="WalletWasabi.Fluent.Mobile.Views.MobileSendView" x:DataType="vm:SendViewModel" x:CompileBindings="True">
  <m:MobilePage Header="Send Bitcoin" ShowBack="True" BackCommand="{Binding CancelCommand}" IsBusy="{Binding IsBusy}">
    <m:MobilePage.Footer><Button Classes="mobile-button primary" Content="Review payment" Command="{Binding NextCommand}" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="MobileReviewPayment"/></m:MobilePage.Footer>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="16,8,16,16" Spacing="18" IsEnabled="{Binding !IsBusy}">
        <TextBlock Text="{Binding Caption}" Classes="mobile-caption"/>
        <StackPanel Spacing="8">
          <TextBlock Text="Recipient" Classes="mobile-label"/>
          <TextBox Classes="mobile-input" Text="{Binding To, Mode=TwoWay}" IsReadOnly="{Binding IsFixedAddress}" MaxLength="500" Watermark="Bitcoin address or payment URI" AutomationProperties.Name="Recipient address"/>
          <Grid ColumnDefinitions="*,*"><Button Classes="mobile-button" Content="Paste address" Command="{Binding PasteCommand}" IsVisible="{Binding IsNotInDonationWorkflow}" HorizontalAlignment="Stretch" Margin="0,0,8,0"/><Button Grid.Column="1" Classes="mobile-button" Content="Scan QR code" Command="{Binding QrCommand}" IsVisible="{Binding IsQrButtonVisible}" HorizontalAlignment="Stretch"/></Grid>
          <TextBlock Text="Silent Payment address: reusable without publishing a conventional receiving address." Classes="mobile-caption" IsVisible="{Binding DisplaySilentPaymentInfo}"/>
        </StackPanel>
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Amount" Classes="mobile-label" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="mobile-button flat" Content="Max" Foreground="{DynamicResource MobileAccent}" Command="{Binding InsertMaxCommand}" IsEnabled="{Binding !IsFixedAmount}"/></Grid>
          <Border Classes="mobile-card">
            <c:DualCurrencyEntryBox AmountBtc="{Binding AmountBtc, Mode=TwoWay}" IsReadOnly="{Binding IsFixedAmount}" ConversionRate="{Binding ExchangeRate}" CurrencyCode="BTC" ConversionCurrencyCode="USD" IsConversionReversed="{Binding ConversionReversed, Mode=TwoWay}" BalanceBtc="{Binding Balance^.Btc}" BalanceUsd="{Binding Balance^.Usd^}" ValidatePasteBalance="False"/>
          </Border>
          <TextBlock Text="The fee will be subtracted from this payment." Classes="mobile-caption" IsVisible="{Binding IsPrimarySubtractFee}"/>
        </StackPanel>
        <StackPanel Spacing="8">
          <TextBlock Text="Recipient labels" Classes="mobile-label"/>
          <TextBlock Text="Only stored in your wallet. Labels help you avoid linking unrelated payments." Classes="mobile-caption"/>
          <c:TagsBox DefaultLabel="{Binding DefaultLabel}" Items="{Binding SuggestionLabels.Labels}" TopItems="{Binding SuggestionLabels.TopSuggestions}" Suggestions="{Binding SuggestionLabels.Suggestions}" IsCurrentTextValid="{Binding SuggestionLabels.IsCurrentTextValid, Mode=OneWayToSource}" ForceAdd="{Binding SuggestionLabels.ForceAdd, Mode=TwoWay}" Watermark="Who are you paying?" TagSeparator="," MaxTextLength="{StaticResource MaxLabelLength}" RestrictInputToSuggestions="False"/>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding AdditionalRecipients}" x:CompileBindings="False">
          <ItemsControl.ItemTemplate><DataTemplate><Border Classes="mobile-card" Margin="0,0,0,12"><StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Additional payment" Classes="mobile-label"/><Button Grid.Column="1" Classes="mobile-button flat" Content="Remove" Command="{Binding Value.RemoveCommand}"/></Grid>
            <TextBox Classes="mobile-input" Text="{Binding Value.To, Mode=TwoWay}" Watermark="Bitcoin address" MaxLength="500"/>
            <TextBlock Text="{Binding Value.AddressError}" Classes="mobile-error"/>
            <Grid ColumnDefinitions="*,Auto"><Button Classes="mobile-button flat" Content="Paste" Command="{Binding Value.PasteCommand}"/><Button Grid.Column="1" Classes="mobile-button flat" Content="Max" Command="{Binding Value.InsertMaxCommand}"/></Grid>
            <c:DualCurrencyEntryBox AmountBtc="{Binding Value.AmountBtc, Mode=TwoWay}" ConversionRate="{Binding $parent[UserControl].DataContext.ExchangeRate}" CurrencyCode="BTC" ConversionCurrencyCode="USD" ValidatePasteBalance="False"/>
            <TextBlock Text="{Binding Value.AmountError}" Classes="mobile-error"/>
            <TextBlock Text="Fee will be subtracted from this payment." Classes="mobile-caption" IsVisible="{Binding Value.IsSubtractFee}"/>
            <c:TagsBox Items="{Binding Value.SuggestionLabels.Labels}" TopItems="{Binding Value.SuggestionLabels.TopSuggestions}" Suggestions="{Binding Value.SuggestionLabels.Suggestions}" IsCurrentTextValid="{Binding Value.SuggestionLabels.IsCurrentTextValid, Mode=OneWayToSource}" ForceAdd="{Binding Value.SuggestionLabels.ForceAdd, Mode=TwoWay}" Watermark="Recipient labels" TagSeparator="," MaxTextLength="{StaticResource MaxLabelLength}"/>
          </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Classes="mobile-button" Content="Add another payment" Command="{Binding AddRecipientCommand}" IsVisible="{Binding IsNotInDonationWorkflow}" HorizontalAlignment="Stretch"/>
        <Border Classes="mobile-note"><Grid ColumnDefinitions="28,*"><m:MobileGlyph Kind="shield" Width="20" Height="20" Foreground="{DynamicResource MobileAccent}"/><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Privacy before signing" Classes="mobile-label"/><TextBlock Text="Next, review the real transaction, network fee, selected coins, and privacy warnings. Nothing is sent by this screen." Classes="mobile-caption"/></StackPanel></Grid></Border>
        <Border Classes="mobile-note" IsVisible="{Binding IsPayJoin}"><TextBlock Text="This payment requests PayJoin. The existing PayJoin validation and authorization workflow will be used." Classes="mobile-caption"/></Border>
      </StackPanel>
    </ScrollViewer>
  </m:MobilePage>
</UserControl>

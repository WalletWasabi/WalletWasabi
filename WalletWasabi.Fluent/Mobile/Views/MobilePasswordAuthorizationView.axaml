<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:WalletWasabi.Fluent.Mobile.Controls"
             xmlns:vm="using:WalletWasabi.Fluent.ViewModels.Dialogs.Authorization"
             x:Class="WalletWasabi.Fluent.Mobile.Views.MobilePasswordAuthorizationView"
             x:DataType="vm:PasswordAuthDialogViewModel" x:CompileBindings="True">
  <m:MobilePage Header="Authorize transaction" ShowBack="True" BackCommand="{Binding CancelCommand}">
    <m:MobilePage.Footer>
      <StackPanel Spacing="{DynamicResource MobileSpaceSmall}">
        <Button Name="AuthorizePassword" Classes="mobile-button primary" Content="{Binding ContinueText}"
                Command="{Binding NextCommand}" HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="MobileAuthorizePassword"/>
        <Button Classes="mobile-button" Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Stretch"/>
      </StackPanel>
    </m:MobilePage.Footer>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="{DynamicResource MobileGutter}" Spacing="{DynamicResource MobileSpaceLarge}">
        <Border Classes="mobile-card">
          <StackPanel Spacing="{DynamicResource MobileSpaceMedium}">
            <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center" Background="{DynamicResource MobileAccentSurface}">
              <m:MobileGlyph Kind="lock" Width="32" Height="32" Foreground="{DynamicResource MobileAccent}"/>
            </Border>
            <TextBlock Text="Approve with your wallet passphrase" Classes="mobile-title" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock Text="Authorize the transaction you just reviewed. Your passphrase is checked by your wallet, not sent to a website." Classes="mobile-caption" TextAlignment="Center"/>
          </StackPanel>
        </Border>
        <StackPanel Spacing="{DynamicResource MobileSpaceSmall}">
          <TextBlock Text="Wallet passphrase" Classes="mobile-label"/>
          <TextBox Name="PassphraseInput" Classes="mobile-input" Text="{Binding Password, Mode=TwoWay}"
                   PasswordChar="●" RevealPassword="False" Watermark="Enter wallet passphrase"
                   AutomationProperties.Name="Wallet passphrase" AutomationProperties.AutomationId="MobileAuthorizationPassphrase"/>
          <TextBlock Name="AuthorizationError" Text="{Binding AuthorizationFailedMessage}" Classes="mobile-error"
                     IsVisible="{Binding HasAuthorizationFailed}"/>
        </StackPanel>
        <Border Classes="mobile-note">
          <TextBlock Text="This is not a request for your recovery words. Never enter recovery words to approve a payment." Classes="mobile-caption"/>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </m:MobilePage>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:WalletWasabi.Fluent.Mobile.Controls" xmlns:c="using:WalletWasabi.Fluent.Controls"
             xmlns:models="using:WalletWasabi.Fluent.Models" xmlns:words="using:WalletWasabi.Fluent.ViewModels.AddWallet.Create"
             xmlns:ime="clr-namespace:Avalonia.Input.TextInput;assembly=Avalonia.Base"
             xmlns:vm="using:WalletWasabi.Fluent.ViewModels.Dialogs"
             x:Class="WalletWasabi.Fluent.Mobile.Views.MobileCreatePasswordView" x:DataType="vm:CreatePasswordDialogViewModel" x:CompileBindings="True">
  
  <m:MobilePage Header="{Binding Title}" ShowBack="True" BackCommand="{Binding CancelCommand}">
    <m:MobilePage.Footer><Button Name="PrimaryAction" Classes="mobile-button primary" Content="Continue" Command="{Binding NextCommand}" HorizontalAlignment="Stretch" /></m:MobilePage.Footer>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="{DynamicResource MobileGutter}" Spacing="{DynamicResource MobileSpaceLarge}">
        <TextBlock Text="{Binding Title}" Classes="mobile-title" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Caption}" Classes="mobile-caption"/>
        <Border Classes="mobile-card"><StackPanel Spacing="{DynamicResource MobileSpaceMedium}">
          <TextBlock Text="Passphrase" Classes="mobile-label"/>
          <TextBox Name="NewPassphrase" Classes="mobile-input" Text="{Binding Password, Mode=TwoWay}"
                   PasswordChar="●" RevealPassword="False" IsUndoEnabled="False" Watermark="Enter passphrase"
                   ime:TextInputOptions.IsSensitive="True" ime:TextInputOptions.ShowSuggestions="False" ime:TextInputOptions.AutoCapitalization="False"
                   AutomationProperties.Name="Wallet passphrase"/>
          <TextBlock Text="Confirm passphrase" Classes="mobile-label"/>
          <TextBox Name="ConfirmPassphrase" Classes="mobile-input" Text="{Binding ConfirmPassword, Mode=TwoWay}"
                   PasswordChar="●" RevealPassword="False" IsUndoEnabled="False" Watermark="Enter the same passphrase"
                   ime:TextInputOptions.IsSensitive="True" ime:TextInputOptions.ShowSuggestions="False" ime:TextInputOptions.AutoCapitalization="False"
                   AutomationProperties.Name="Confirm wallet passphrase"/>
        </StackPanel></Border>
        <Border Classes="mobile-note"><TextBlock Text="When restoring, use the exact passphrase from the original wallet. A different passphrase can produce a different wallet. This passphrase cannot be reset for you." Classes="mobile-caption"/></Border>
      </StackPanel>
    </ScrollViewer>
  </m:MobilePage>
</UserControl>

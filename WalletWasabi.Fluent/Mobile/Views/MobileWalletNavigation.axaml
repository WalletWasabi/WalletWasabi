<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:WalletWasabi.Fluent.Mobile.Controls" xmlns:p="using:WalletWasabi.Fluent.Mobile.Presentation"
             x:Class="WalletWasabi.Fluent.Mobile.Views.MobileWalletNavigation"
             x:DataType="p:IMobileWalletPresentation" x:CompileBindings="True">
  <UserControl.Resources><m:MobileNavigationSectionConverter x:Key="NavigationSection"/></UserControl.Resources>
  <Border BorderBrush="{DynamicResource MobileDivider}" BorderThickness="0,1,0,0" Background="{DynamicResource MobileSurface}" Padding="8,4">
    <Panel>
      <UniformGrid Name="DarkNavigation" Columns="4" Rows="1" IsVisible="{DynamicResource MobileDarkLayout}">
        <m:MobileActionButton Label="Home" Icon="home" Background="Transparent" BorderThickness="0" Command="{Binding NavigateCommand}" CommandParameter="home" IsSelected="{Binding Section, Converter={StaticResource NavigationSection}, ConverterParameter=home}"/>
        <m:MobileActionButton Label="Transactions" Icon="history" Background="Transparent" BorderThickness="0" Command="{Binding NavigateCommand}" CommandParameter="history" IsSelected="{Binding Section, Converter={StaticResource NavigationSection}, ConverterParameter=history}"/>
        <m:MobileActionButton Label="Privacy" Icon="shield" Background="Transparent" BorderThickness="0" Command="{Binding NavigateCommand}" CommandParameter="privacy" IsSelected="{Binding Section, Converter={StaticResource NavigationSection}, ConverterParameter=privacy}"/>
        <m:MobileActionButton Label="Discover" Icon="discover" Background="Transparent" BorderThickness="0" Command="{Binding NavigateCommand}" CommandParameter="discover" IsSelected="{Binding Section, Converter={StaticResource NavigationSection}, ConverterParameter=discover}"/>
      </UniformGrid>
      <UniformGrid Name="LightNavigation" Columns="5" Rows="1" IsVisible="{DynamicResource MobileLightLayout}">
        <m:MobileActionButton Label="Home" Icon="home" Background="Transparent" BorderThickness="0" Command="{Binding NavigateCommand}" CommandParameter="home" IsSelected="{Binding Section, Converter={StaticResource NavigationSection}, ConverterParameter=home}"/>
        <m:MobileActionButton Label="Send" Icon="send" Background="Transparent" BorderThickness="0" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}"/>
        <m:MobileActionButton Label="Receive" Icon="receive" Background="Transparent" BorderThickness="0" Command="{Binding ReceiveCommand}"/>
        <m:MobileActionButton Label="Privacy" Icon="shield" Background="Transparent" BorderThickness="0" Command="{Binding NavigateCommand}" CommandParameter="privacy" IsSelected="{Binding Section, Converter={StaticResource NavigationSection}, ConverterParameter=privacy}"/>
        <m:MobileActionButton Label="History" Icon="history" Background="Transparent" BorderThickness="0" Command="{Binding NavigateCommand}" CommandParameter="history" IsSelected="{Binding Section, Converter={StaticResource NavigationSection}, ConverterParameter=history}"/>
      </UniformGrid>
    </Panel>
  </Border>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="using:WalletWasabi.Fluent.Mobile.Controls" xmlns:vm="using:WalletWasabi.Fluent.Mobile.ViewModels" x:Class="WalletWasabi.Fluent.Mobile.Views.MobileSendFeeView" x:CompileBindings="True">
  <m:MobilePage Name="Root" x:DataType="vm:MobileFeeViewModel" Header="Network fee" ShowBack="True" BackCommand="{Binding Source.BackCommand}" IsBusy="{Binding Source.IsBusy}">
    <m:MobilePage.Footer><Button Classes="mobile-button primary" Content="Use selected fee" Command="{Binding Source.NextCommand}" IsEnabled="{Binding HasEstimates}" HorizontalAlignment="Stretch"/></m:MobilePage.Footer>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="16,16" Spacing="20">
      <TextBlock Text="Choose a confirmation target" Classes="mobile-title" TextWrapping="Wrap"/>
      <TextBlock Text="Rates come from your configured fee provider. Presets are limited to the targets supported by those estimates." Classes="mobile-caption"/>
      <ItemsControl ItemsSource="{Binding Options}" IsEnabled="{Binding HasEstimates}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MobileFeeOption"><Button Classes="mobile-button" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}" HorizontalAlignment="Stretch" Padding="4,16" Margin="2"><StackPanel Spacing="10"><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{Binding Estimate}" Classes="mobile-caption" HorizontalAlignment="Center"/><TextBlock Text="{Binding Rate}" Foreground="{DynamicResource MobileAccent}" FontSize="12" HorizontalAlignment="Center"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Border Classes="mobile-card"><StackPanel Spacing="16"><TextBlock Text="{Binding Source.FeeChart.CurrentSatoshiPerByte, StringFormat='{}{0:0.###} sat/vB'}" Classes="mobile-amount" HorizontalAlignment="Center"/><TextBlock Text="{Binding Source.FeeChart.CurrentConfirmationTargetString}" Classes="mobile-caption" HorizontalAlignment="Center"/><Slider Minimum="{Binding Source.FeeChart.SliderMinimum}" Maximum="{Binding Source.FeeChart.SliderMaximum}" Value="{Binding Source.FeeChart.SliderValue, Mode=TwoWay}" IsEnabled="{Binding HasEstimates}" AutomationProperties.Name="Confirmation target"/></StackPanel></Border>
      <Button Classes="mobile-button" Content="Custom fee rate" Command="{Binding Source.AdvancedOptionsCommand}" HorizontalAlignment="Stretch"/>
      <Border Classes="mobile-note"><TextBlock Text="Confirmation times are estimates, not promises. The final fee depends on the transaction's actual virtual size and is shown before signing." Classes="mobile-caption"/></Border>
    </StackPanel></ScrollViewer>
  </m:MobilePage>
</UserControl>

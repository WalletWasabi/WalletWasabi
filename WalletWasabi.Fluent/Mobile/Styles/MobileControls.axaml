<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="using:WalletWasabi.Fluent.Mobile.Controls" xmlns:b="using:WalletWasabi.Fluent.Mobile.Behaviors">
  <Styles.Resources>
    <m:MobileSectionConverter x:Key="MobileSectionEquals"/>
    <x:Double x:Key="MobilePageHeaderHeight">64</x:Double>
    <x:Double x:Key="MobileActionHeight">64</x:Double>
    <x:Double x:Key="MobileActionIconSize">22</x:Double>
    <x:Double x:Key="MobileActionLabelSize">11</x:Double>
    <Thickness x:Key="MobilePageFooterMargin">16,8,16,16</Thickness>
    <Thickness x:Key="MobileActionPadding">4,10</Thickness>
    <DataTemplate x:Key="MobilePageTitleTemplate" x:DataType="x:String">
      <TextBlock Text="{Binding}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                 TextAlignment="Center" Foreground="{DynamicResource MobileText}"/>
    </DataTemplate>
    <ControlTheme x:Key="{x:Type m:MobilePage}" TargetType="m:MobilePage">
      <Setter Property="HeaderTemplate" Value="{StaticResource MobilePageTitleTemplate}"/>
      <Setter Property="Background" Value="{DynamicResource MobileBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource MobileText}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="(Interaction.Behaviors)">
        <BehaviorCollectionTemplate><BehaviorCollection><b:MobileBusyBehavior/></BehaviorCollection></BehaviorCollectionTemplate>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid RowDefinitions="Auto,*,Auto" Background="{TemplateBinding Background}">
            <Grid Name="PART_HeaderLayout" ColumnDefinitions="48,*,48" ColumnSpacing="4" Margin="8,0" MinHeight="{DynamicResource MobilePageHeaderHeight}"
                  IsEnabled="{TemplateBinding IsBusy, Converter={x:Static BoolConverters.Not}}">
              <Button Classes="mobile-button flat" Width="{DynamicResource MobileTouchTarget}" Command="{TemplateBinding BackCommand}" IsVisible="{TemplateBinding ShowBack}" AutomationProperties.Name="Back">
                <m:MobileGlyph Kind="back" Width="20" Height="20" Foreground="{DynamicResource MobileText}"/>
              </Button>
              <ContentPresenter Name="PART_HeaderPresenter" Grid.Column="1" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"/>
              <ContentPresenter Name="PART_HeaderActionsPresenter" Grid.Column="2" Content="{TemplateBinding HeaderActions}" VerticalAlignment="Center" HorizontalContentAlignment="Center"/>
            </Grid>
            <ContentPresenter Grid.Row="1" Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                              IsEnabled="{TemplateBinding IsBusy, Converter={x:Static BoolConverters.Not}}"/>
            <StackPanel Grid.Row="2">
              <ProgressBar IsIndeterminate="True" IsVisible="{TemplateBinding IsBusy}" Height="2" Foreground="{DynamicResource MobileAccent}"/>
              <ContentPresenter Name="PART_FooterPresenter" Content="{TemplateBinding Footer}" HorizontalContentAlignment="Stretch" Margin="{DynamicResource MobilePageFooterMargin}"
                                IsEnabled="{TemplateBinding IsBusy, Converter={x:Static BoolConverters.Not}}"/>
            </StackPanel>
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type m:MobileActionButton}" TargetType="m:MobileActionButton">
      <Setter Property="MinHeight" Value="{DynamicResource MobileActionHeight}"/>
      <Setter Property="MinWidth" Value="{DynamicResource MobileTouchTarget}"/>
      <Setter Property="Padding" Value="{DynamicResource MobileActionPadding}"/>
      <Setter Property="Background" Value="{DynamicResource MobileCardFill}"/>
      <Setter Property="Foreground" Value="{DynamicResource MobileSecondary}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource MobileBorder}"/>
      <Setter Property="BorderThickness" Value="{DynamicResource MobileHairline}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource MobileInputRadius}"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
            <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border Name="PART_IconCircle" CornerRadius="24" HorizontalAlignment="Center">
                <m:MobileGlyph Name="PART_Icon" Kind="{TemplateBinding Icon}" Width="{DynamicResource MobileActionIconSize}" Height="{DynamicResource MobileActionIconSize}" Foreground="{TemplateBinding Foreground}"/>
              </Border>
              <TextBlock Name="PART_Label" Text="{TemplateBinding Label}" FontSize="{DynamicResource MobileActionLabelSize}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter>
      <!-- Quick actions are tiles in dark mode and free circular buttons in light mode.
           Navigation buttons keep the smaller icon-only treatment. -->
      <Style Selector="^.quick">
        <Setter Property="MinHeight" Value="96"/>
        <Setter Property="Background" Value="{DynamicResource MobileQuickFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MobileQuickBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource MobileText}"/>
        <Setter Property="Padding" Value="4,12"/>
      </Style>
      <Style Selector="^.quick /template/ Border#PART_IconCircle">
        <Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/>
        <Setter Property="Background" Value="{DynamicResource MobileAccentSurface}"/>
      </Style>
      <Style Selector="^.quick /template/ m|MobileGlyph#PART_Icon">
        <Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/>
        <Setter Property="Foreground" Value="{DynamicResource MobileAccent}"/>
      </Style>
      <Style Selector="^.quick /template/ TextBlock#PART_Label"><Setter Property="FontSize" Value="12"/></Style>
      <Style Selector="^:selected"><Setter Property="Foreground" Value="{DynamicResource MobileAccent}"/><Setter Property="Background" Value="{DynamicResource MobileAccentSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource MobileAccent}"/></Style>
      <Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource MobileRaised}"/></Style>
      <Style Selector="^:pressed"><Setter Property="Opacity" Value="0.7"/></Style>
      <Style Selector="^:focus-visible /template/ Border#PART_Surface"><Setter Property="BorderBrush" Value="{DynamicResource MobileAccent}"/><Setter Property="BorderThickness" Value="2"/></Style>
      <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.4"/></Style>
    </ControlTheme>
  </Styles.Resources>
</Styles>
